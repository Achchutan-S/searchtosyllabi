# LLM provider config — OpenAI-compatible chat-completions shape.
# Default provider is Gemini via its OpenAI-compatible endpoint.
# Swapping to Groq / OpenRouter / local Ollama / Claude later is a config-only change:
# just point GEMINI_BASE_URL/GEMINI_MODEL/GEMINI_API_KEY at the new provider.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.6-flash

# Search provider config
TAVILY_API_KEY=your-tavily-api-key

# Cache config — a result cache in front of the pipeline, so re-running an
# already-generated subject costs zero LLM calls instead of ~40.
# A local `mongod` is the default; MongoDB Atlas's free (M0) tier works fine here
# too — paste its SRV connection string, e.g.
#   MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/?retryWrites=true
# The cache is optional: if Mongo is unreachable the pipeline still runs, it just
# pays full quota for every run. `cli doctor` reports the connection either way.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=syllabus_agent
# Cached entries older than this are treated as a miss and regenerated.
CACHE_TTL_DAYS=30
